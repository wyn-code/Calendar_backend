# ============================================================
# Copia este archivo como `.env` y ajusta los valores locales.
#   cp .env.example .env      (Linux / macOS)
#   copy .env.example .env    (Windows)
# ============================================================

# --- General ---
PROJECT_NAME=Agenda Psicologa API
API_V1_PREFIX=/api/v1
VERSION=0.1.0

# --- Base de datos PostgreSQL ---
# Formato: postgresql+psycopg://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/calend

# --- Seguridad / JWT ---
# Genera una clave segura, por ejemplo con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS (orígenes permitidos para React) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
